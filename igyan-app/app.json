{
  "expo": {
    "name": "IGYAAN",
    "slug": "igyanai",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon.png",
    "scheme": "igyanapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.igyan.app",
      "infoPlist": {
        "UIApplicationSceneManifest": {
          "UIApplicationSupportsMultipleScenes": false,
          "UISceneConfigurations": {
            "UIWindowSceneSessionRoleApplication": [
              {
                "UISceneConfigurationName": "Default Configuration",
                "UISceneDelegateClassName": "$(PRODUCT_MODULE_NAME).SceneDelegate"
              }
            ]
          }
        },
        "NSCameraUsageDescription": "This app needs access to the camera for video calls and live classes.",
        "NSMicrophoneUsageDescription": "This app needs access to the microphone for audio communication in live classes.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to share images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f5f8ff",
        "foregroundImage": "./assets/brand/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.igyan.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-scenes",
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/igyan-ai-mark.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f5f8ff",
          "dark": {
            "backgroundColor": "#121212"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5ef59cf8-df5f-4805-9ec3-54a9a829dea4"
      }
    },
    "owner": "igyanais-organization"
  }
}
